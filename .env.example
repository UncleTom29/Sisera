# ==============================================================================
# Sisera Environment Configuration Template (.env)
# ==============================================================================

# Data & Universe (§3, §4)
SISERA_UNIVERSE_SIZE=200
SISERA_BYBIT_BASE_URL=https://api.bybit.com
SISERA_BYBIT_TESTNET_BASE_URL=https://api-testnet.bybit.com
SISERA_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
SISERA_COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
SISERA_DERIBIT_BASE_URL=https://www.deribit.com/api/v2
SISERA_CACHE_DB=sisera_cache.db
SISERA_LEDGER_DB=sisera_ledger.db
SISERA_UNIVERSE_CACHE_TTL=86400
SISERA_RECONCILIATION_TOLERANCE_PCT=1.0
SISERA_RECONCILIATION_ACTION=penalize
SISERA_HTTP_TIMEOUT=10
SISERA_HTTP_MAX_RETRIES=3

# Execution & Mode (§11)
SISERA_BYBIT_API_KEY=
SISERA_BYBIT_API_SECRET=
SISERA_USE_TESTNET=true
SISERA_POST_ONLY_TIMEOUT_SECONDS=30.0
SISERA_ALPHA_DECAY_FACTOR=1.0
SISERA_ORDER_SLICING_DEPTH_RATIO=0.15
SISERA_MAX_ORDER_SLICES=4

# Risk & Portfolio Management (§9)
SISERA_TOP_N_PORTFOLIO_SIZE=8
SISERA_MAX_CORRELATION_CLUSTER_EXPOSURE=0.40
SISERA_MAX_BTC_BETA_EXPOSURE=2.5
SISERA_KELLY_MULTIPLIER=0.5
SISERA_MAX_POSITION_NOTIONAL_PCT=0.20
SISERA_MAX_TOTAL_NOTIONAL_PCT=1.0
SISERA_MAX_LEVERAGE_CEILING=20.0
SISERA_MARGIN_MODE=isolated
SISERA_LIQ_BUFFER_STRESS_MULTIPLIER=1.5
SISERA_PORTFOLIO_STRESS_BTC_SHOCK_PCT=-0.06
SISERA_MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
SISERA_MAX_PORTFOLIO_MARGIN_RATIO=0.70
SISERA_MAX_DAILY_TRADES=20
SISERA_ATR_STOP_MULTIPLIER=2.5
SISERA_ATR_ACTIVATION_PCT=0.01
SISERA_DVOL_WIDEN_FACTOR=1.3

# Cadence & Scheduling (§4)
SISERA_SCAN_INTERVAL_SECONDS=900
SISERA_FAST_MONITOR_INTERVAL_SECONDS=300
SISERA_POS_REEVALUATION_INTERVAL=60

# LLM Fundamental Analysis -- live/paper-forward only, never backtested (see
# NOT_BACKTESTABLE_INDICATORS). Off by default: paid API via OpenRouter, opt in deliberately.
SISERA_ENABLE_LLM_FUNDAMENTAL=false
SISERA_OPENROUTER_API_KEY=
SISERA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SISERA_OPENROUTER_MODEL=openai/gpt-5.6-luna
SISERA_LLM_FUNDAMENTAL_CACHE_TTL=86400
SISERA_LLM_FUNDAMENTAL_RESOLVE_HOURS=168

# Breaking News Monitor (RSS + Telegram channels) -- live/paper-forward only, never
# backtested (see NOT_BACKTESTABLE_INDICATORS). Off by default. RSS monitoring works with
# no credentials; Telegram channel monitoring additionally needs the API id/hash below
# (free, from https://my.telegram.org) plus a one-time interactive login -- run
# `uv run python scripts/telegram_login.py` -- and a channel list you choose yourself
# (deliberately not pre-populated; see sisera/data/telegram_news.py).
SISERA_ENABLE_NEWS_MONITOR=false
SISERA_NEWS_MONITOR_INTERVAL_SECONDS=180
SISERA_NEWS_MIN_URGENCY_FOR_ACTION=0.5
SISERA_NEWS_RESOLVE_HOURS=4
SISERA_TELEGRAM_NEWS_API_ID=
SISERA_TELEGRAM_NEWS_API_HASH=
SISERA_TELEGRAM_NEWS_SESSION_PATH=sisera_telegram_news
SISERA_TELEGRAM_NEWS_CHANNELS=
# Recommended starting list (your own research, verified this session) -- copy into
# SISERA_TELEGRAM_NEWS_CHANNELS above to activate; left empty by default on purpose, same
# reasoning as the X account list below.
# SISERA_TELEGRAM_NEWS_CHANNELS=coindeskglobal,wublockchainenglish,cointelegraph,whale_alert,WhaleBotAlerts

# Event Intelligence: Classification, Source Reliability, Corroboration -- refinements to
# the Breaking News Monitor above, gated by the same SISERA_ENABLE_NEWS_MONITOR. Every news
# item now also gets an event_category (macro_fed, crypto_etf, security_hack, etc.) and an
# S1-S5 severity tier; source reliability and cross-source corroboration are tracked and
# fed back into each new assessment as real data instead of guesswork.
SISERA_NEWS_CORROBORATION_WINDOW_SECONDS=3600
SISERA_NEWS_HIGH_SEVERITY_ALERT_THRESHOLD=4
SISERA_EVENT_ATTRIBUTION_MIN_SETTLED=10
SISERA_EVENT_ATTRIBUTION_ROLLING_WINDOW=30

# Event Intelligence: Macro Data (FRED/Treasury/DeFiLlama) -- free. Defaults ON (unlike the
# paid LLM features above) since there's no cost risk: free data, and every sub-signal
# gracefully drops out (not a fabricated reading) if a key is missing or a fetch fails.
# FRED needs a free, instant self-serve key from https://fred.stlouisfed.org/docs/api/api_key.html
# -- Treasury and DeFiLlama need nothing at all.
SISERA_ENABLE_MACRO_REGIME=true
SISERA_FRED_API_KEY=
SISERA_FRED_BASE_URL=https://api.stlouisfed.org/fred
SISERA_TREASURY_FISCAL_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service
SISERA_DEFILLAMA_BASE_URL=https://api.llama.fi
SISERA_MACRO_DATA_CACHE_TTL=21600

# Event Intelligence: X/Twitter Ingestion -- OFF by default. X discontinued its free API
# tier in February 2026; this is now a real, ongoing paid cost ($0.005 per post read, no
# free allowance) that scales with news volume, not a fixed subscription -- it costs the
# most on exactly the high-volume days (Fed/war/oil shocks) this feature is meant to catch.
# Requires BOTH the enable flag and a spend cap you set deliberately; SISERA_X_MAX_DAILY_SPEND_USD
# is a hard stop XClient checks BEFORE every call, not an estimate.
SISERA_ENABLE_X_INGESTION=false
SISERA_X_BEARER_TOKEN=
SISERA_X_MAX_DAILY_SPEND_USD=2.0
SISERA_X_POLL_INTERVAL_SECONDS=180
SISERA_X_MAX_RESULTS_PER_CALL=25
SISERA_X_TRACKED_ACCOUNTS=
# Recommended starting list -- trimmed from your original research to exclude accounts
# already covered for free elsewhere in this file (CoinDesk/WuBlockchain: RSS + Telegram
# above; DefiLlama: SISERA_DEFILLAMA_BASE_URL above; federalreserve/BLS_gov/BEA_News/
# USTreasury: FRED/Treasury above give the actual structured numbers instead of parsing
# tweets). Left empty by default on purpose -- copy into SISERA_X_TRACKED_ACCOUNTS above,
# and only after setting a spend cap you're comfortable with, to activate.
# SISERA_X_TRACKED_ACCOUNTS=DeItaone,FirstSquawk,Newsquawk,zerohedge,WatcherGuru,BitcoinMagazine,lookonchain,whale_alert,ArkhamIntel,PeckShieldAlert,KaikoData,CFTC,CMEGroup

# Web Dashboard & API (§14)
SISERA_WEB_HOST=0.0.0.0
SISERA_WEB_PORT=8000

# Telegram Bot Interface (§14)
SISERA_TELEGRAM_BOT_TOKEN=
SISERA_TELEGRAM_CHAT_ID=
SISERA_TELEGRAM_POLLING_ENABLED=false

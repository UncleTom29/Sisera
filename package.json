{
  "name": "sisera",
  "version": "0.2.0",
  "private": true,
  "description": "Institutional multi-asset trading operating system",
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "turbo run build --cache-dir=.turbo/cache",
    "dev": "turbo run dev --parallel --cache-dir=.turbo/cache",
    "dev:web": "pnpm --filter @sisera/web dev",
    "dev:api": "pnpm --filter @sisera/api dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test --cache-dir=.turbo/cache",
    "typecheck": "turbo run typecheck --cache-dir=.turbo/cache"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}

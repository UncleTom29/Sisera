{
  "name": "sisera",
  "version": "0.1.0",
  "private": true,
  "description": "Sisera intelligent multi-asset trading terminal",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @sisera/web dev",
    "dev:mobile": "pnpm --filter @sisera/mobile start",
    "build:web": "pnpm --filter @sisera/web build",
    "build": "pnpm -r run build --if-present",
    "typecheck": "pnpm -r run typecheck --if-present",
    "test": "pnpm -r run test --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
